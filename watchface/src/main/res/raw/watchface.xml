<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="14:22:00" />

    <UserConfigurations>
        <ColorConfiguration
            id="accentColor"
            displayName="config_accent_name"
            defaultValue="berry">
            <ColorOption
                id="berry"
                displayName="accent_berry"
                colors="#FFFF9BC7 #FF3A2842" />
            <!-- Only Beere or neutral: Bernstein stays reserved for deviations (DESIGN.md), so it is no accent. -->
            <ColorOption
                id="pure"
                displayName="accent_pure"
                colors="#FFF8F2F8 #FF343138" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">
        <!-- Slot 1: Full-face live bus map background (450x450). Pure OLED black when no ride is active; tap opens Watch Live Map. -->
        <ComplicationSlot
            slotId="1"
            name="slot_map_name"
            displayName="slot_map_name"
            x="0"
            y="0"
            width="450"
            height="450"
            supportedTypes="PHOTO_IMAGE EMPTY"
            isCustomizable="TRUE">
            <DefaultProviderPolicy
                primaryProvider="de.luca.mitfahrt/de.luca.mitfahrt.wear.RideMapComplicationService"
                primaryProviderType="PHOTO_IMAGE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="450" height="450" />
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="450" height="450" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
                </PartImage>
                <!-- Compact floating translucent pill behind clock only so the fullscreen bus map shines edge-to-edge. -->
                <PartDraw x="96" y="22" width="258" height="106" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="258" height="106" cornerRadiusX="34" cornerRadiusY="34">
                        <Fill color="#8C12151B" />
                    </RoundRectangle>
                </PartDraw>
            </Complication>
            <Complication type="EMPTY">
                <PartDraw x="135" y="207" width="180" height="2" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="180" height="2" cornerRadiusX="1" cornerRadiusY="1">
                        <Fill color="#FF282B33" />
                    </RoundRectangle>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- Top rim battery progress arc (hidden in ambient mode to preserve OLED battery). -->
        <PartDraw x="0" y="0" width="450" height="450" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Arc
                centerX="225"
                centerY="225"
                width="430"
                height="430"
                startAngle="-36"
                endAngle="36"
                direction="CLOCKWISE">
                <Stroke color="#FF292D36" thickness="5" cap="ROUND" />
            </Arc>
            <Arc
                centerX="225"
                centerY="225"
                width="430"
                height="430"
                startAngle="-36"
                endAngle="-36"
                direction="CLOCKWISE">
                <Transform target="endAngle" value="-36 + ([BATTERY_PERCENT] * 0.72)" />
                <Stroke color="[CONFIGURATION.accentColor.0]" thickness="5" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- Date and watch battery percentage row. -->
        <PartText x="108" y="28" width="148" height="28" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <Text align="END" ellipsis="TRUE" maxLines="1">
                <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FFD0D4DE">
                    <Template>%s %s.%s.<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <PartText x="262" y="28" width="80" height="28" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <Text align="START" ellipsis="TRUE" maxLines="1">
                <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFD0D4DE">
                    <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Primary digital clock (WFF v1 requires lowercase hh:mm with SYNC_TO_DEVICE for 24h/12h). -->
        <DigitalClock x="75" y="54" width="300" height="74" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="210" />
            <TimeText
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                x="0"
                y="0"
                width="300"
                height="74"
                align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="64" weight="BOLD" color="#FFF7F8FA" />
            </TimeText>
        </DigitalClock>

        <!-- Slot 2: next stop, minutes to it and arrival. Floating neutral dark card over the fullscreen map. -->
        <ComplicationSlot
            slotId="2"
            name="slot_transit_name"
            displayName="slot_transit_name"
            x="64"
            y="296"
            width="322"
            height="66"
            supportedTypes="LONG_TEXT SHORT_TEXT EMPTY"
            isCustomizable="TRUE">
            <DefaultProviderPolicy
                primaryProvider="de.luca.mitfahrt/de.luca.mitfahrt.wear.RideDetailComplicationService"
                primaryProviderType="LONG_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingRoundBox x="0" y="0" width="322" height="66" cornerRadius="20" />

            <Complication type="LONG_TEXT">
                <PartDraw x="0" y="0" width="322" height="66" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="322" height="66" cornerRadiusX="20" cornerRadiusY="20">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="320" height="64" cornerRadiusX="19" cornerRadiusY="19">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="14" y="6" width="294" height="28" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="185" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#FFF7F8FA">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="14" y="36" width="294" height="24" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="145" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#FFD0D4DE">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="322" height="66" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="322" height="66" cornerRadiusX="20" cornerRadiusY="20">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="320" height="64" cornerRadiusX="19" cornerRadiusY="19">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="14" y="8" width="294" height="26" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="185" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#FFF7F8FA">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="14" y="36" width="294" height="22" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="145" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="15" weight="MEDIUM" color="#FFD0D4DE">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Slot 3: free slot the wearer fills, e.g. with music. Control radius 12 like the app's buttons, not a pill. -->
        <ComplicationSlot
            slotId="3"
            name="slot_media_name"
            displayName="slot_media_name"
            x="125"
            y="368"
            width="200"
            height="50"
            supportedTypes="LONG_TEXT SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE RANGED_VALUE EMPTY"
            isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingRoundBox x="0" y="0" width="200" height="50" cornerRadius="12" />

            <Complication type="LONG_TEXT">
                <PartDraw x="0" y="0" width="200" height="50" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="200" height="50" cornerRadiusX="12" cornerRadiusY="12">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="198" height="48" cornerRadiusX="11" cornerRadiusY="11">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="16" y="5" width="168" height="22" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#FFF7F8FA">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="16" y="27" width="168" height="18" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="120" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="MEDIUM" color="#FFD0D4DE">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="200" height="50" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="200" height="50" cornerRadiusX="12" cornerRadiusY="12">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="198" height="48" cornerRadiusX="11" cornerRadiusY="11">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartImage x="14" y="11" width="28" height="28" tintColor="[CONFIGURATION.accentColor.0]" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="46" y="12" width="138" height="26" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="160" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FFF7F8FA">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="200" height="50" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="200" height="50" cornerRadiusX="12" cornerRadiusY="12">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="198" height="48" cornerRadiusX="11" cornerRadiusY="11">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="16" y="12" width="168" height="26" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="160" />
                    <Text align="CENTER" ellipsis="TRUE" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FFF7F8FA">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartDraw x="75" y="0" width="50" height="50" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="50" height="50" cornerRadiusX="12" cornerRadiusY="12">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="48" height="48" cornerRadiusX="11" cornerRadiusY="11">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartImage x="82" y="7" width="36" height="36" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartDraw x="75" y="0" width="50" height="50" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <RoundRectangle x="0" y="0" width="50" height="50" cornerRadiusX="12" cornerRadiusY="12">
                        <Fill color="#CC14171D" />
                    </RoundRectangle>
                    <RoundRectangle x="1" y="1" width="48" height="48" cornerRadiusX="11" cornerRadiusY="11">
                        <Stroke color="[CONFIGURATION.accentColor.1]" thickness="1.5" />
                    </RoundRectangle>
                </PartDraw>
                <PartImage x="85" y="10" width="30" height="30" tintColor="[CONFIGURATION.accentColor.0]" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
