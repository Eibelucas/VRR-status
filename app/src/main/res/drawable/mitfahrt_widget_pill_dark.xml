<?xml version="1.0" encoding="utf-8"?>
<!-- Widget control: 48 dp touch area, 36 dp visible chip with the 12 dp control radius. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="6dp">
    <shape android:shape="rectangle">
        <solid android:color="#FF372A3E" />
        <stroke android:width="1dp" android:color="#FF52405C" />
        <corners android:radius="12dp" />
    </shape>
</inset>
