<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mitfahrt_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/mitfahrt_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/mitfahrt_widget_bg"
        android:tint="@color/mitfahrt_widget_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/mitfahrt_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mitfahrt_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/mitfahrt_widget_label"
                    android:textColor="@color/mitfahrt_widget_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/mitfahrt_widget_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mitfahrt_widget_loading"
                    android:textColor="@color/mitfahrt_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/mitfahrt_widget_map"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/mitfahrt_widget_button"
                android:contentDescription="@string/mitfahrt_widget_open_map"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mitfahrt_widget_ic_map"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/mitfahrt_widget_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/mitfahrt_widget_button"
                android:contentDescription="@string/mitfahrt_widget_refresh"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mitfahrt_widget_ic_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/mitfahrt_widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mitfahrt_widget_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mitfahrt_widget_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
