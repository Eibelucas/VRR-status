<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mitfahrt_map_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Neutral widget base (visible in compact/empty mode and behind rounded corners). -->
    <ImageView
        android:id="@+id/mitfahrt_map_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/mitfahrt_widget_bg" />

    <!-- Full-bleed map filling 100% of the widget. -->
    <ImageView
        android:id="@+id/mitfahrt_map_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/mitfahrt_map_widget_label"
        android:scaleType="fitXY" />

    <!-- Top floating overlay row: LineSign + target on the left (tightly wrapped), compact 2-mode toggle on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <!-- Floating top-left LineSign + target badge. -->
            <LinearLayout
                android:id="@+id/mitfahrt_map_widget_header_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/mitfahrt_map_chip_light"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/mitfahrt_map_widget_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/mitfahrt_map_line_sign"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="32dp"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mitfahrt_map_widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mitfahrt_map_widget_label"
                    android:textColor="@color/mitfahrt_widget_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Single compact toggle between Zoom Out (Strecke) and Zoom In (Bus-Fokus). -->
        <LinearLayout
            android:id="@+id/mitfahrt_map_widget_mode_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mitfahrt_map_chip_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/mitfahrt_map_widget_mode_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/mitfahrt_widget_ic_focus" />

            <TextView
                android:id="@+id/mitfahrt_map_widget_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Bus"
                android:textColor="@color/mitfahrt_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating bottom-left compact status + live age chip (leaves bottom-right clear for OSM credit). -->
    <LinearLayout
        android:id="@+id/mitfahrt_map_widget_status_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="66dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/mitfahrt_map_chip_light"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/mitfahrt_map_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/mitfahrt_map_widget_empty"
            android:textColor="@color/mitfahrt_widget_muted"
            android:textSize="11sp" />

        <Chronometer
            android:id="@+id/mitfahrt_map_widget_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mitfahrt_widget_muted"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
